# Copy to backend/.env for local development (backend/.env is git-ignored).
# See autoapplier/config.py:Settings for defaults and validation.

# local | test | ci — "test" and "ci" force LLM_PROVIDER=fake (no live LLM calls in tests).
APP_ENV=local

# Local Supabase (bash team/bin/app.sh supabase). Filled in automatically by
# scripts/sync_env.py once Task 2 adds it; leave blank to use Settings' defaults.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# HS256 fallback only; ES256 tokens are verified via JWKS.
# Filled by scripts/sync_env.py from JWT_SECRET.
SUPABASE_JWT_SECRET=

# fake | anthropic | openai | openrouter. "fake" needs no API key.
LLM_PROVIDER=fake
# Suggested model ids for the Anthropic adapter: LLM_MODEL_SMART=claude-opus-5,
# LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_FAST=
LLM_MODEL_SMART=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Valkey (Redis-protocol, BSD-3): Celery broker + result backend, app keys (ADR-0012).
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=aa:

# Seconds. queue_heartbeat_max_age_s must be greater than worker_heartbeat_interval_s.
WORKER_HEARTBEAT_INTERVAL_S=10
QUEUE_HEARTBEAT_MAX_AGE_S=30
HEALTH_PROBE_TIMEOUT_S=2
