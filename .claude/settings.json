{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "TEAM_ROLE_GUARD": "on",
    "TEAM_DEV_GATE": "on",
    "TEAM_DEV_GATE_RETRIES": "2",
    "TEAM_GOAL_TURNS": "200",
    "STRIX_LLM": "anthropic/claude-sonnet-4-6",
    "STRIX_REASONING_EFFORT": "medium"
  },
  "permissions": {
    "allow": [
      "Bash(python3 team/bin/*)",
      "Bash(bash team/bin/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(node *)",
      "Bash(playwright-cli *)",
      "Bash(supabase *)",
      "Bash(strix *)",
      "mcp__supabase-local",
      "WebSearch"
    ],
    "deny": [
      "Bash(supabase db push *)",
      "Bash(supabase link *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Read(./.env)",
      "Read(./.env.production)",
      "Read(./.env.prod)",
      "mcp__plugin_supabase_supabase"
    ]
  },
  "enabledMcpjsonServers": [
    "supabase-local",
    "playwright-test"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/role-guard.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "backend-dev|frontend-dev",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dev-gate.py",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  }
}
