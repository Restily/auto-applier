# Copy to apps/web/.env.local for local development (.env.local is
# git-ignored). Filled in automatically by `python3 scripts/sync_env.py`
# from local Supabase's status once it is running.

# The Python API. Called server-side only — see src/lib/env.server.ts; the
# browser never receives this.
API_URL=http://127.0.0.1:8000

# The public origin of this app (server-side). The Google sign-in redirect is
# built from it: `${APP_ORIGIN}/auth/callback`. Must be in Supabase's redirect allow-list.
APP_ORIGIN=http://localhost:3000

# Public: safe to expose to the browser (RLS keeps data safe, not secrecy of
# these). See src/lib/env.public.ts and src/lib/supabase/{server,client}.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
